;; Variables
(deflisten river-state :initial ""
  `ristate -t -vt`)
(defvar jqt 
  ".viewstag.BOE + [ .tags.BOE[0] | tonumber ] | unique | sort | [range(1; (. | max) + 1) as $r | if any(.[]; . == $r) then $r else 0 end]")

;; Windows
(defwindow indicator
  :monitor 0
  :geometry (geometry 
    :anchor "bottom center")
  :stacking "bottom"
  :exclusive true
  (workspace-indicator))


;; Widgets
(defwidget workspace-indicator []
  (box 
    :orientation "horizontal"
    :space-evenly false
    :spacing 24
    :class "indicator-box"
    (for entry in {jq(river-state, jqt)}
	    (label 
        :class "indicator-text"
        :text 
		    {entry == river-state.tags.BOE[0]
			    ? "▣" 
			    : entry == 0
				    ? "□" : "▨" }))))
